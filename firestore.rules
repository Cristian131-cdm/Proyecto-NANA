rules_version = '2';

// Reglas de NANA. Cada quien ve solo lo de su familia.
// Diseño: docs/superpowers/specs/2026-10-25-registro-huella-design.md (sección 9)
service cloud.firestore {
  match /databases/{database}/documents {

    function conSesion() {
      return request.auth != null;
    }

    function esFamilia(datos) {
      return request.auth.uid == datos.uidAdulto
          || request.auth.uid in datos.idsCuidadores;
    }

    function adulto(folio) {
      return get(/databases/$(database)/documents/adultos/$(folio)).data;
    }

    function adultoDespues(folio) {
      return getAfter(/databases/$(database)/documents/adultos/$(folio)).data;
    }

    // Quien dio de alta a la persona: administra todo.
    function esPrincipal(datos) {
      return request.auth.uid == datos.creadoPor;
    }

    // A quien el principal dejó en su lugar, mientras no venza.
    function esSuplente(datos) {
      return datos.get('suplente', null) != null
          && datos.suplente.uid == request.auth.uid
          && (datos.suplente.hasta == null || request.time < datos.suplente.hasta);
    }

    function administra(datos) {
      return esPrincipal(datos) || esSuplente(datos);
    }

    function soloCambia(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos);
    }

    match /usuarios/{uid} {
      allow read, write: if conSesion() && request.auth.uid == uid;
    }

    match /adultos/{folio} {
      allow read: if conSesion() && esFamilia(resource.data);

      // Lo crea un cuidador (que se pone a sí mismo) o el propio adulto al registrarse.
      allow create: if conSesion() && (
          (request.resource.data.idsCuidadores == [request.auth.uid]
              && request.resource.data.uidAdulto == null)
          || (request.resource.data.uidAdulto == request.auth.uid
              && request.resource.data.idsCuidadores == []));

      // La familia lo edita sin tocar quién cuida. Salud, reglas de alerta,
      // suplente, apariencia y quién dio de alta solo los cambia el principal.
      allow update: if conSesion() && esFamilia(resource.data)
          && request.resource.data.idsCuidadores == resource.data.idsCuidadores
          && request.resource.data.uidAdulto == resource.data.uidAdulto
          && (esPrincipal(resource.data)
              || !request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['salud', 'reglasAlerta', 'suplente', 'apariencia',
                           'creadoPor', 'consentimiento']));

      // El principal saca a alguien de la familia (nunca a sí mismo).
      allow update: if conSesion() && esPrincipal(resource.data)
          && soloCambia(['idsCuidadores', 'suplente'])
          && request.resource.data.idsCuidadores.size() == resource.data.idsCuidadores.size() - 1
          && resource.data.idsCuidadores.hasAll(request.resource.data.idsCuidadores)
          && request.auth.uid in request.resource.data.idsCuidadores;

      // Canje del código: el celular del adulto se pone como uidAdulto
      // solo si en el mismo batch marca como usado un código vigente de este folio.
      allow update: if conSesion()
          && soloCambia(['uidAdulto', 'tieneCelular', 'codigoCanjeado'])
          && request.resource.data.uidAdulto == request.auth.uid
          && get(/databases/$(database)/documents/codigos/$(request.resource.data.codigoCanjeado)).data.usado == false
          && get(/databases/$(database)/documents/codigos/$(request.resource.data.codigoCanjeado)).data.get('tipo', 'adulto') != 'familiar'
          && getAfter(/databases/$(database)/documents/codigos/$(request.resource.data.codigoCanjeado)).data.folio == folio
          && getAfter(/databases/$(database)/documents/codigos/$(request.resource.data.codigoCanjeado)).data.usadoPor == request.auth.uid;

      // Invitación familiar: quien tiene cuenta se agrega a sí mismo (y solo a
      // sí mismo) como cuidador, si en el mismo batch marca como usado un
      // código vigente de este folio que sea de tipo 'familiar'.
      allow update: if conSesion()
          && soloCambia(['idsCuidadores', 'codigoFamiliar'])
          && !(request.auth.uid in resource.data.idsCuidadores)
          && request.resource.data.idsCuidadores == resource.data.idsCuidadores.concat([request.auth.uid])
          && get(/databases/$(database)/documents/codigos/$(request.resource.data.codigoFamiliar)).data.usado == false
          && get(/databases/$(database)/documents/codigos/$(request.resource.data.codigoFamiliar)).data.get('tipo', 'adulto') == 'familiar'
          && getAfter(/databases/$(database)/documents/codigos/$(request.resource.data.codigoFamiliar)).data.folio == folio
          && getAfter(/databases/$(database)/documents/codigos/$(request.resource.data.codigoFamiliar)).data.usadoPor == request.auth.uid;

      // "Borrar todos los datos": solo quien dio de alta a la persona.
      allow delete: if conSesion() && resource.data.creadoPor == request.auth.uid;

      // Al dar de alta (o al unirse con una invitación), el cuidador escribe su
      // fila en el mismo batch en que queda en idsCuidadores.
      match /cuidadores/{uid} {
        allow read: if conSesion() && esFamilia(adulto(folio));
        allow create: if conSesion() && request.auth.uid == uid
            && request.auth.uid in adultoDespues(folio).idsCuidadores;
        allow update: if conSesion() && request.auth.uid == uid;
        allow delete: if conSesion()
            && adulto(folio).creadoPor == request.auth.uid;
      }

      // Lo del día: toda la familia y la persona mayor.
      match /{coleccion}/{id} {
        allow read, write: if conSesion()
            && coleccion in ['registros', 'alertas']
            && esFamilia(adulto(folio));
      }

      // Medicinas y rutinas: las ve toda la familia; las cambian el
      // principal y su suplente.
      match /{coleccion}/{id} {
        allow read: if conSesion()
            && coleccion in ['medicamentos', 'rutinas']
            && esFamilia(adulto(folio));
        allow write: if conSesion()
            && coleccion in ['medicamentos', 'rutinas']
            && administra(adulto(folio));
      }

      // Recetas y citas (salud): las ven la persona, el principal y el
      // suplente; solo el principal las cambia.
      match /{coleccion}/{id} {
        allow read: if conSesion()
            && coleccion in ['recetas', 'citas']
            && (administra(adulto(folio))
                || request.auth.uid == adulto(folio).uidAdulto);
        allow write: if conSesion()
            && coleccion in ['recetas', 'citas']
            && esPrincipal(adulto(folio));
      }
    }

    match /codigos/{codigo} {
      // Se lee uno por su número exacto; nunca se puede listar.
      allow get: if conSesion();
      allow list: if false;

      allow create: if conSesion()
          && request.resource.data.creadoPor == request.auth.uid
          && request.resource.data.usado == false
          // Invitar es del principal; el código del celular de la persona
          // también lo puede sacar el suplente.
          && (esPrincipal(adulto(request.resource.data.folio))
              || (esSuplente(adulto(request.resource.data.folio))
                  && request.resource.data.get('tipo', 'adulto') != 'familiar'));

      allow update: if conSesion()
          && resource.data.usado == false
          && request.time < resource.data.expira
          && soloCambia(['usado', 'usadoPor'])
          && request.resource.data.usado == true
          && request.resource.data.usadoPor == request.auth.uid;

      allow delete: if false;
    }
  }
}
